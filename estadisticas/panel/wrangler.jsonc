{
  // Worker del panel. Solo lee. Se protege con Cloudflare Access (ver estadisticas/LEEME.md).
  "name": "micrositio-panel",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    // Se completan después de activar Access. No son secretos.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micrositio-estadisticas",
      "database_id": "90016ab0-0d8b-486d-bbe4-92d12742cdde"
    }
  ]
}
