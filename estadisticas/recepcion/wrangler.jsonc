{
  // Worker público que recibe los avisos de las páginas (visita virtual y app de la vitrina). Solo escribe en la base.
  "name": "crilar-recepcion",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Único origen autorizado a enviar avisos (las dos páginas están en este dominio).
    "ORIGEN_PERMITIDO": "https://segon03.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crilar-estadisticas",
      // No es un secreto. Se reemplaza por el ID de la base creada en Cloudflare.
      "database_id": "REEMPLAZAR_POR_EL_ID_DE_LA_BASE"
    }
  ]
}
