{
  // Worker público que recibe los avisos del micrositio de la Noche de los Museos. Solo escribe en la base.
  "name": "micrositio-recepcion",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Único origen autorizado a enviar avisos.
    "ORIGEN_PERMITIDO": "https://segon03.github.io",
    // Desde cuándo se guardan las visitas: 27/11/2026 17:00 hora de Argentina, una hora antes de la apertura.
    // Antes de esa hora los avisos se reciben pero no se guardan. Vacío = se cuenta siempre.
    "CONTAR_DESDE": "1795809600",
    // Inscripción al sorteo: del 27/11/2026 18:00 al 30/11/2026 08:00, hora de Argentina.
    // Antes se reciben pero no se guardan; después se rechazan (410) y el formulario muestra el cartel de cierre.
    "SORTEO_DESDE": "1795813200",
    "SORTEO_HASTA": "1796036400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micrositio-estadisticas",
      // No es un secreto. Se reemplaza por el ID de la base creada en Cloudflare.
      "database_id": "90016ab0-0d8b-486d-bbe4-92d12742cdde"
    }
  ]
}
